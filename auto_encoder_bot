app = Client("auto_reuploader_session", api_id=API_ID, api_hash=API_HASH, bot_token=BOT_TOKEN)

def process_video_ffmpeg(input_path: str, output_path: str) -> bool:
    """
    FFmpeg command jo video ko Web Streamable banati hai:
    - Codec: H.264 (Video) + AAC (Audio)
    - movflags +faststart: MOOV atom ko file ke start me move karta hai.
    """
    cmd = [
        "ffmpeg", "-y",
        "-i", input_path,
        "-c:v", "libx264", "-preset", "veryfast", "-crf", "23",
        "-c:a", "aac", "-b:a", "128k",
        "-movflags", "+faststart",
        output_path
    ]
    try:
        subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except Exception as e:
        print(f"FFmpeg Error: {e}")
        return False

@app.on_message(filters.private & (filters.video | filters.document))
async def handle_incoming_video(client, message):
    status_msg = await message.reply_text("⏳ **Step 1/3:** Video download ho rahi hai...")
    
    input_file = await message.download()
    output_file = f"fixed_{os.path.basename(input_file)}"
    if not output_file.endswith(".mp4"):
        output_file += ".mp4"

    await status_msg.edit_text("⚙️ **Step 2/3:** FastStart & Web-Codec (H.264/AAC) apply ho raha hai...")
    
    # Non-blocking FFmpeg execution
    success = await asyncio.to_thread(process_video_ffmpeg, input_file, output_file)
    
    file_to_upload = output_file if success else input_file
    
    await status_msg.edit_text("📤 **Step 3/3:** Target Channel me Direct Upload ho raha hai...")
    
    try:
        await client.send_video(
            chat_id=TARGET_CHANNEL,
            video=file_to_upload,
            caption=message.caption or "",
            supports_streaming=True  # Essential for ArtPlayer streaming
        )
        await status_msg.edit_text("✅ **Done!** Video successfully fix aur upload ho gayi hai. Ab Bot 1 rescan chalayein.")
    except Exception as e:
        await status_msg.edit_text(f"❌ Upload Failed: {str(e)}")
    finally:
        # Temporary files clean up
        if os.path.exists(input_file):
            os.remove(input_file)
        if os.path.exists(output_file):
            os.remove(output_file)

if __name__ == "__main__":
    print("🚀 Auto-Uploader & FastStart Encoder Bot Active!")
    app.run()
